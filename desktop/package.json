{
  "name": "apifix-bin",
  "version": "1.1.0",
  "description": "轻量级接口调试工具 — 无需登录，支持cURL/Postman导入，本地存储",
  "main": "main.js",
  "scripts": {
    "start": "node copy-html.js && electron .",
    "build": "node copy-html.js && electron-builder --win --publish never",
    "build:mac": "node copy-html.js && electron-builder --mac --publish never",
    "build:all": "node copy-html.js && electron-builder --win --mac --publish never",
    "build:portable": "node copy-html.js && electron-builder --win portable --publish never"
  },
  "author": "ApiFix Bin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bin-Hu-Ling/apifix-bin-pro.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.apifix.bin",
    "productName": "ApiFix Bin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Bin-Hu-Ling",
      "repo": "apifix-bin-pro",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApiFix Bin"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": null
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
