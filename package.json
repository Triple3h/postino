{
  "name": "postino",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:all": "node build.js --no-typecheck",
    "build:ext": "node build.js --ext-only --no-typecheck",
    "build:desktop": "node build.js --desktop-only --no-typecheck",
    "build:desktop:win": "node build.js --desktop-only --win --no-typecheck",
    "build:desktop:mac": "node build.js --desktop-only --mac --no-typecheck",
    "build:desktop:all": "node build.js --desktop-only --all --no-typecheck",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:facade": "vite build --config vite.facade.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "codemirror": "^6.0.1",
    "dexie": "^4.4.2",
    "pinia": "^3.0.4",
    "splitpanes": "^4.1.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "vue-tippy": "^6.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.99.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.8"
  }
}
